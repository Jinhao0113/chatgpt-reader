{
  "manifest_version": 3,
  "name": "ChatGPT Reader",
  "version": "1.5.3",
  "description": "为 ChatGPT 添加实时回答目录、选文侧边提问、PDF 排版、搜索与段落收藏。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ChatGPT 阅读面板",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared.js",
        "rich-export.js",
        "bridge.js",
        "page-agent.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "打开或关闭阅读面板"
    }
  }
}
